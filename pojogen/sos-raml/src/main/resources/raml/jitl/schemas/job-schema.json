  ],
  "properties": {
    "name": {
		"type": "string",
  		"minLength": 1
	},
	"category": {
		"type": "string"
	},
	"language": {
		"type": "string",
  		"default": "Java"
	},
	"class": {
	    "type": "string"
	},
    "arguments": {
        "type": "array",
        "uniqueItems": true,
        "items": {
            "$ref": "param-schema.json"
        }
    },
    "returnVariables": {
        "type": "array",
        "uniqueItems": true,
        "items": {
            "$ref": "param-schema.json"
        }
    }
  },
  "additionalProperties": false
}